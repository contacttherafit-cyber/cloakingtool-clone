<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CloakingTool | Free & Open — Advanced Traffic Filtering</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{scroll-behavior:smooth;--bs-blue:#0d6efd;--bs-indigo:#6610f2;--bs-purple:#6f42c1;--bs-pink:#d63384;--bs-red:#dc3545;--bs-orange:#fd7e14;--bs-yellow:#ffc107;--bs-green:#198754;--bs-teal:#20c997;--bs-cyan:#0dcaf0;--bs-white:#fff;--bs-gray:#6c757d;--bs-gray-dark:#343a40;--bs-primary:#0d6efd;--bs-secondary:#6c757d;--bs-success:#198754;--bs-info:#0dcaf0;--bs-light:#f8f9fa;--bs-dark:#212529;--bs-gradient:linear-gradient(180deg,rgba(255,255,255,.15),rgba(255,255,255,0))}
        body{font-family:'Inter',system-ui,-apple-system,BlinkMacSystemFont,sans-serif;background:#020617;color:#e2e8f0;line-height:1.6;overflow-x:hidden}a{text-decoration:none;color:inherit}
        .ct-header{position:fixed;top:0;left:0;width:100%;z-index:100;padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between;background:rgba(2,6,23,.95);backdrop-filter:blur(8px);border-bottom:1px solid rgba(148,163,184,.1)}
        .ct-logo{display:flex;align-items:center;gap:.75rem}img.ct-logo-img{height:32px}.ct-logo-text{font-weight:700;font-size:1.25rem;background:linear-gradient(135deg,#60a5fa,#34d399);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .ct-nav-links{display:flex;gap:2rem;align-items:center}.ct-nav-links a{text-decoration:none;color:#94a3b8;font-size:.9rem;transition:color .2s}.ct-nav-links a:hover{color:#fff}
        .ct-btn{display:inline-block;padding:.5rem 1.25rem;border-radius:6px;font-weight:600;font-size:.9rem;text-decoration:none;cursor:pointer;transition:all .2s}.ct-btn-primary{background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;border:none}.ct-btn-primary:hover{transform:translateY(-1px);box-shadow:0 4px 20px rgba(59,130,246,.4)}.ct-btn-ghost{background:transparent;color:#e2e8f0;border:1px solid #334155}.ct-btn-ghost:hover{border-color:#60a5fa;background:rgba(96,165,250,.1)}
        .d-none{display:none!important}.d-flex{display:flex!important}.flex-column{flex-direction:column!important}.position-absolute{position:absolute!important}.w-100{width:100%!important}
        .ct-hero{text-align:center;padding:8rem 2rem 4rem;position:relative}.ct-hero::before{content:'';position:absolute;top:-20%;left:50%;transform:translateX(-50%);width:600px;height:600px;background:radial-gradient(circle,rgba(59,130,246,.15),transparent 70%);z-index:-1}
        .ct-badge{display:inline-flex;align-items:center;gap:.5rem;padding:.375rem 1rem;border-radius:20px;background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.2);font-size:.8rem;color:#60a5fa;margin-bottom:1.5rem}.ct-badge-dot{width:6px;height:6px;border-radius:50%;background:#3b82f6;animation:pulse 2s infinite}@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
        .fw-bold{font-weight:700!important}.text-white,.text-primary,.text-muted,.text-warning,.text-danger,.text-success{color:#fff}.text-primary{color:#60a5fa!important}.text-muted{color:#94a3b8!important}.text-warning{color:#fbbf24!important}.text-danger{color:#ef4444!important}.text-success{color:#34d399!important}
        .fs-1{font-size:3rem;font-weight:800;margin-bottom:1rem;line-height:1.2}.fs-1 span{background:linear-gradient(135deg,#60a5fa,#34d399);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .text-muted{color:#94a3b8;font-size:1.1rem;margin-bottom:2rem}
        .ct-terminal-ui{background:rgba(15,23,42,.9);border:1px solid rgba(148,163,184,.3);border-radius:12px;box-shadow:0 20px 40px rgba(0,0,0,.6);font-family:'Fira Code',monospace;font-size:.85rem;padding:1.5rem;display:inline-block;text-align:left;margin:2rem auto}
        .blink{animation:blink 1s step-start infinite}@keyframes blink{50%{opacity:0}}
        .ct-scroller-wrapper,.ct-scroller-track,.ct-scroller-group,.ct-scroller-item{text-align:center}.ct-scroller-wrapper{display:flex;align-items:center;padding:3rem 2rem;background:#0f172a;border-top:1px solid rgba(148,163,184,.05);border-bottom:1px solid rgba(148,163,184,.05)}.ct-scroller-track{overflow-x:auto;white-space:nowrap;display:flex;gap:3rem}.ct-scroller-item{display:inline-flex;flex-direction:column;align-items:center;gap:.5rem;color:#94a3b8;font-size:.85rem;padding:1rem;border-radius:8px;background:rgba(255,255,255,.03)}
        .ct-section{padding:5rem 2rem;max-width:1200px;margin:0 auto}.ct-section-title{text-align:center;margin-bottom:3rem}h2.ct-title{font-size:2.25rem;font-weight:700;color:#fff}.text-center{text-align:center}.mx-auto{margin-left:auto!important;margin-right:auto!important}.mb-3,.mb-4,.mb-5{margin-bottom:.75rem 1.5rem 3rem}
        .ct-card{background:#0f172a;border-radius:16px;padding:2rem;display:flex;flex-direction:column;text-align:center;border:1px solid rgba(148,163,184,.05)}
        .d-flex{display:flex!important}.align-items-center{align-items:center!important}.justify-content-between{justify-content:space-between!important}.gap-2{gap:.75rem!important}.mt-2,.mt-4,.mb-2,.mb-4{margin-top:inherit;margin-bottom:inherit}
        .ct-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3rem}.ct-grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem;margin-top:3rem}
        .h-100{height:100%!important}.flex-grow-1{flex-grow:1!important}
        .fs-5{font-size:1.25rem;font-weight:bold;color:#60a5fa}
        .ct-tag{display:inline-block;padding:.2rem .5rem;border-radius:4px;background:rgba(96,165,250,.1);color:#60a5fa;font-family:'Fira Code',monospace;font-size:.7rem;margin-top:.5rem}
        .ct-routing-diagram{display:flex;align-items:center;justify-content:center;gap:1.5rem;padding:3rem;background:#0f172a;border-radius:16px;margin-top:3rem;font-size:.95rem;flex-wrap:wrap}.ct-node{padding:1.5rem;background:rgba(59,130,246,.1);border-radius:12px;text-align:center;min-width:180px;border:1px solid rgba(59,130,246,.2)}
        .ct-node-source{background:rgba(59,130,246,.1)}.ct-node-whitepage{background:#0c2d1a;border-color:#34d399}.ct-node-offer{background:#2d0c1a;border-color:#f87171}.ct-node-filter{background:rgba(59,130,246,.15);border-color:#3b82f6}
        .ct-micro-label{font-size:.7rem;color:#64748b;display:block;margin-top:.25rem}
        .ct-node-filter-text{font-weight:bold;font-size:.9rem}.opacity-50{opacity:.5!important}
        .ms-1{margin-left:.25rem!important}.ms-2{margin-left:.5rem!important}
        .ct-faq-item{border-bottom:1px solid rgba(148,163,184,.1);padding:1.25rem 0;cursor:pointer}.ct-faq-content{color:#94a3b8;margin-top:.75rem;line-height:1.6;display:none}.ct-faq-item.open .ct-faq-content{display:block}
        .mt-4{margin-top:1rem!important}.mb-5{margin-bottom:3rem!important}
        footer.ct-footer{background:#020617;border-top:1px solid rgba(148,163,184,.05);padding:3rem 2rem;text-align:center;color:#94a3b8;font-size:.9rem}
        .d-inline-flex{display:inline-flex!important}.bg-transparent{background:transparent!important}.rounded-pill{border-radius:2rem!important}
        @media(max-width:768px){.ct-grid-3,.ct-grid-2{grid-template-columns:1fr}.ct-routing-diagram{flex-direction:column}.fs-1{font-size:2rem}}
    </style>
</head>
<body>

<!-- HEADER -->
