</header>

<!-- HERO -->
<section class="ct-hero" id="top">
  <div class="ct-badge"><span class="ct-badge-dot"></span>PROPERLY CLOAKED — FREE & OPEN SOURCE</div>
  <h1 class="fs-1">CloakingTool<br /><span>The #1 Traffic Filtering & Ad Cloaking Tool</span></h1>
  <p class="text-muted mx-auto" style="max-width:600px">Precise traffic filtering, bot detection, and safe funnel routing. Real-time AI-powered cloaking — free for everyone.</p>

  <!-- Terminal Live Log -->
  <div class="ct-terminal-ui"><div style="display:flex;align-items:center;gap:.5rem;padding-bottom:.75rem;border-bottom:1px solid rgba(148,163,184,.2);margin-bottom:.75rem"><span style="width:10px;height:10px;background:#ef4444;border-radius:50%;display:inline-block"></span><span style="width:10px;height:10px;background:#eab308;border-radius:50%;display:inline-block"></span><span style="width:10px;height:10px;background:#22c55e;border-radius:50%;display:inline-block"></span><span class="ms-2 text-muted" style="font-size:.7rem">ct-filter-node.js</span></div><div id="terminal-lines" style="color:#a3b8cc;line-height:1.8;font-family:'Fira Code',monospace"><div><span class="text-primary">&gt;</span> Initializing cloaked flow... <span class="text-success">[OK]</span></div><div><span class="text-primary">&gt;</span> Bypassing Keitaro local server... <span class="text-success">[OK]</span></div><div id="terminal-log" style="margin-top:.5rem"></div><div class="mt-4 opacity-50"><span class="text-primary">&gt;</span> Awaiting next click... <span class="blink">_</span></div></div></div>
</section>

<!-- SCROLLER / COMPATIBILITY -->
