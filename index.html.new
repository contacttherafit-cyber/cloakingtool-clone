  <!-- Routing Diagram -->
  <div class="ct-routing-diagram">
    <div class="ct-node ct-node-source"><i class="bi bi-arrow-down-circle fs-1"></i><br/>Ad Traffic<span class="ct-micro-label">Source</span></div>
    <span style="font-size:2rem;color:#60a5fa">&rarr;</span>
    <div class="ct-node ct-node-filter"><strong>CloakingTool Engine</strong><br/><small>Detection Rules<span class="ct-micro-label">Real-Time</span></small></div>
    <span style="font-size:2rem;color:#60a5fa">&rarr;</span>
    <div style="display:flex;flex-direction:column;gap:.5rem"><div class="ct-node ct-node-whitepage"><strong>White Page</strong><br/><small>Bots & Reviewers<span class="ct-micro-label">Safe Mode</span></small></div><div class="ct-node ct-node-offer"><strong>Your Offer</strong><br/><small>Real Users<span class="ct-micro-label">High Conversion</span></small></div></div>
  </div>

  <!-- Steps -->
  <div class="d-flex justify-content-between align-items-center mb-3 mt-4" style="max-width:1200px;margin-inline:auto"><span class="fs-5 fw-bold text-primary">Step 01</span><h3 class="fw-bold" style="font-size:1.5rem;color:#fff">Connect Your Traffic</h3></div>
  <p class="text-muted mx-auto mb-5" style="max-width:600px;margin-inline:auto">Import your campaign links from Keitaro, Facebook Ads Manager, Google Ads, TikTok Ads or any tracking system. The engine evaluates fingerprints in real-time and executes routing rules instantly.</p>
  <div class="ct-grid-3">
    <div class="ct-card"><div class="ct-card-icon mb-3"><i class="bi bi-code-square fs-1 text-primary"></i></div><h4>Connect</h4><p style="color:#94a3b8;margin-top:.5rem;font-size:.9rem">Import campaign links from any tracker. Compatible with Keitaro, Voluum, ClickDealer.</p><span class="ct-tag">[CONNECT: OK]</span></div>
    <div class="ct-card"><div class="ct-card-icon mb-3"><i class="bi bi-gear fs-1 text-primary"></i></div><h4>Define Rules</h4><p style="color:#94a3b8;margin-top:.5rem;font-size:.9rem">Create rules based on GEO, OS, time of visit, VPN status, referrer, language, and custom IP ASN blocks.</p><span class="ct-tag">[RULES: ACTIVE]</span></div>
    <div class="ct-card"><div class="ct-card-icon mb-3"><i class="bi bi-graph-up-arrow fs-1 text-primary"></i></div><h4>Optimize</h4><p style="color:#94a3b8;margin-top:.5rem;font-size:.9rem">Watch your traffic flow in real-time. Check analytics logs for every visitor. Ensure safe delivery.</p><span class="ct-tag">[MONITOR: LIVE]</span></div>
  </div>
</section>

<!-- FEATURES -->
<section id="features" style="padding-top:5rem">
  <h2 class="ct-title mb-3 text-center" style="text-align:center;margin-bottom:1.5rem!important">Core Features</h2>
  <p class="text-muted mx-auto mb-5" style="max-width:600px;text-align:center;margin-inline:auto">Built for media buyers who need precision.</p>

  <div class="ct-grid-2">
    <div class="ct-card d-flex align-items-center gap-3"><i class="bi bi-shield-check fs-2 text-primary"></i><div style="flex-grow:1"><h4>Bon Detection Engine</h4><p style="color:#94a3b8;font-size:.9rem;margin-top:.25rem">Detects 50+ bot signatures in real-time: Googlebot, Bingbot, YandexBot, Baiduspider, Facebookexternalhit, Twitterbot, LinkedInBot, AhrefsBot, SemrushBot, Applebot, Slackbot, Discordbot, WhatsApp, TelegramBot...</p><span class="ct-tag">[SAFE_MODE: ON]</span></div></div>
    <div class="ct-card d-flex align-items-center gap-3"><i class="bi bi-globe2 fs-2 text-primary"></i><div style="flex-grow:1"><h4>GEO Rules</h4><p style="color:#94a3b8;font-size:.9rem;margin-top:.25rem">Combine GEO, OS, time of visit, VPN status, referrer, language, and custom IP ASN blocks to control your cloaked traffic.</p><span class="ct-tag">[GEO_RULES: ACTIVE]</span></div></div>
    <div class="ct-card d-flex align-items-center gap-3"><i class="bi bi-phone fs-2 text-primary"></i><div style="flex-grow:1"><h4>Device Detection</h4><p style="color:#94a3b8;font-size:.9rem;margin-top:.25rem">Mobile, Desktop, Tablet — detect and serve tailored experiences. Touch capability + screen size analysis.</p><span class="ct-tag">[DEVICE_ID: DETECTED]</span></div></div>
    <div class="ct-card d-flex align-items-center gap-3"><i class="bi bi-graph-up-arrow fs-2 text-primary"></i><div style="flex-grow:1"><h4>Real-Time Analytics</h4><p style="color:#94a3b8;font-size:.9rem;margin-top:.25rem">Monitor every visitor, check logs in real-time. See exactly who is being cloaked and why.</p><span class="ct-tag">[REALTIME: LIVE]</span></div></div>
    <div class="ct-card d-flex align-items-center gap-3"><i class="bi bi-cloud-arrow-up fs-2 text-primary"></i><div style="flex-grow:1"><h4>Cloud Sync</h4><p style="color:#94a3b8;font-size:.9rem;margin-top:.25rem">All rules and configs stored in the cloud. Access from anywhere, sync across devices.</p><span class="ct-tag">[CLOUD_SYNC]</span></div></div>
    <div class="ct-card d-flex align-items-center gap-3"><i class="bi bi-cpu fs-2 text-primary"></i><div style="flex-grow:1"><h4>AI-Powered Cloaking</h4><p style="color:#94a3b8;font-size:.9rem;margin-top:.25rem">Machine learning models continuously optimize detection accuracy and reduce false positives.</p><span class="ct-tag">[AI_MODEL: v2.5]</span></div></div>
  </div>

  <!-- Guarantee Banner -->
  <div style="background:#0f172a;border-radius:16px;padding:2rem;margin-top:3rem;text-align:center;border:1px solid rgba(59,130,246,.2)">
    <span class="d-block fw-bold text-white mb-2">FREE & OPEN ACCESS</span>
    <p style="color:#94a3b8;font-size:.9rem;margin-bottom:1rem">No credit card required. No limits on traffic volume.</p>
    <i class="bi bi-check-circle-fill fs-1 text-success"></i>
  </div>
</section>

<!-- FAQ -->
<section id="faq" style="padding-top:5rem">
  <h2 class="ct-title mb-3 text-center" style="text-align:center;margin-bottom:1.5rem!important">FAQ</h2>
  <p class="text-muted mx-auto mb-5" style="max-width:600px;text-align:center;margin-inline:auto">Everything you need to know about CloakingTool.</p>

  <div style="max-width:800px;margin:0 auto">
    <div class="ct-faq-item"><h4 class="fw-bold">What is cloaking?</h4><div class="ct-faq-content"><p>Cloaking is the practice of showing different content to different visitors. Bots and reviewers see a "safe" page while real users see your actual offer.</p></div></div>
    <div class="ct-faq-item"><h4 class="fw-bold">How does bot detection work?</h4><div class="ct-faq-content"><p>The engine analyzes User-Agent strings, IP addresses, device fingerprints, and behavioral signals in real-time to distinguish bots from human visitors.</p></div></div>
    <div class="ct-faq-item"><h4 class="fw-bold">Can I use it with my existing tracker?</h4><div class="ct-faq-content"><p>Yes. CloakingTool integrates seamlessly with Keitaro, Voluum, ClickDealer, and any platform that supports standard tracking links.</p></div></div>
    <div class="ct-faq-item"><h4 class="fw-bold">Is it really free?</h4><div class="ct-faq-content"><p>Yes! No credit card required. No limits on traffic volume. Fully open access for everyone.</p></div></div>
  </div>
</section>

<!-- FOOTER -->
<footer class="ct-footer"><p>&copy; 2026 CloakingTool — Free & Open Source.</p><p style="margin-top:.5rem;font-size:.8rem">Powered by advanced AI cloaking technology. All traffic is properly filtered and safe.</p></footer>

<script>
// ===== CLOAKING ENGINE (Real Tech) =====
(function(){
  // Full bot signatures — matches original CloakingTool engine
  var BOT_PATTERNS = [
    /googlebot/i, /bingbot/i, /yandexbot/i, /baiduspider/i,
    /facebookexternalhit/i, /twitterbot/i, /linkedinbot/i,
    /slurp/i, /msnbot/i, /ahrefsbot/i, /semrushbot/i,
    /mj12bot/i, /dotbot/i, /rogerbot/i,
    /applebot/i, /slackbot/i, /discordbot/i,
    /whatsapp/i, /telegrambot/i,
    /spider|crawler|scraper|bot/i
  ];

  var MOBILE_PATTERNS = [/iphone|ipad|android.*mobile|windows phone|blackberry|opera mini|opera mobi|silk/i];

  function isBot() { return BOT_PATTERNS.some(function(p){ return p.test(navigator.userAgent); }); }
  function isMobile() { var ua = navigator.userAgent; if ('ontouchstart' in window && (window.innerWidth < 768)) return true; return MOBILE_PATTERNS.some(function(p){ return p.test(ua); }); }

  // Terminal animation — replicates original ct-filter-node.js log
  var terminalLogEl = document.getElementById('terminal-log');
  if (terminalLogEl) {
    var logs = [
      'Analyzing request [IP: ' + (Math.floor(Math.random()*255)+'.'+Math.floor(Math.random()*255)+'.xx.xx') + ']',
      'UA: ' + navigator.userAgent.substring(0,60).replace(/</g,'&lt;'),
      isBot() ? 'FLAG: Bot detected — redirecting to White-Page' : '✓ Human visitor routed to Offer',
      isMobile() ? '→ Mobile device (touch detected)' : '→ Desktop detected',
      'Cloaking rules applied successfully.'
    ];
    var idx = 0;
    function tick(){
      if(idx < logs.length){
        terminalLogEl.innerHTML += '<div style="margin-top:.25rem"><span class="text-primary">&gt;</span> ' + logs[idx] + '</div>';
        idx++;
        setTimeout(tick, 800);
      } else {
        var cloaked = isBot();
        terminalLogEl.innerHTML += '<div class="mt-2 fw-bold text-danger">[' + (cloaked ? 'BLOCK' : 'ALLOW') + '] Routing decision: ' + (cloaked ? 'White-Page' : 'Offer Page') + '.</div>';
      }
    }
    setTimeout(tick, 500);
  }

  // Mobile Nav Toggle — matches original implementation
  var navToggle = document.getElementById('navToggle');
  var navMenu = document.getElementById('navMenu');
  if (navToggle && navMenu) {
    navToggle.addEventListener("click", function(){
      navMenu.classList.toggle('d-none');
      navMenu.classList.toggle('d-flex');
    });
  }
})();

// FAQ Accordion
document.querySelectorAll('.ct-faq-item').forEach(function(item){
  item.addEventListener('click', function() { this.classList.toggle('open'); });
});
</script>

</body>
</html>
